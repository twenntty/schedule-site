# ─────────────────────────────────────────────────────────────
# SchedGO — frontend environment variables
# Copy this file to `.env` and adjust the values.
#   cp .env.example .env
# Note: Create React App only exposes variables prefixed with REACT_APP_.
# ─────────────────────────────────────────────────────────────

# Base URL of the SchedGO backend API (the schedule-api service).
# Local development default:
REACT_APP_API_URL=http://localhost:3001
